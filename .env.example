# Copy to .env. Without OPENAI_API_KEY the app runs in deterministic_only mode (still via MCP).
OPENAI_API_KEY=
# Any tool-calling model available to your account that supports the Responses API + JSON schema output.
OPENAI_MODEL=gpt-5-mini

# Optional tuning
CG_REVIEW_DATE=2026-09-15
CG_MAX_TOOL_ROUNDS=4
CG_LLM_TIMEOUT_S=60
CG_LLM_MAX_RETRIES=2
CG_MCP_TOOL_TIMEOUT_S=15
# Server startup imports scikit-learn/pandas; raise this on a slow or cold machine.
CG_MCP_CONNECT_TIMEOUT_S=90
